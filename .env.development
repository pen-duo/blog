# 开发环境配置
NODE_ENV=development

# Cloudflare R2 配置 (开发环境)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-dev-access-key-id
R2_SECRET_ACCESS_KEY=your-dev-secret-access-key
R2_BUCKET_NAME=blog-images-dev
R2_CUSTOM_DOMAIN=https://images-dev.yourdomain.com

# 图片管理访问密码 (开发环境)
REACT_APP_IMAGE_MANAGER_PASSWORD=dev123

# 其他开发环境配置
DEBUG=true
LOG_LEVEL=debug
