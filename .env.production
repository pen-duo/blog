# 生产环境配置
NODE_ENV=production

# Cloudflare R2 配置 (生产环境)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-prod-access-key-id
R2_SECRET_ACCESS_KEY=your-prod-secret-access-key
R2_BUCKET_NAME=blog-images-prod
R2_CUSTOM_DOMAIN=https://images.yourdomain.com

# 图片管理访问密码 (生产环境)
REACT_APP_IMAGE_MANAGER_PASSWORD=prod-secure-password-123

# 其他生产环境配置
DEBUG=false
LOG_LEVEL=error
